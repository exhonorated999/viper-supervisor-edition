{
  "name": "viper-supervisor-edition",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "lan": "node lan-node/server.mjs",
    "dev:all": "concurrently -n lan,web -c cyan,blue \"npm run lan\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "desktop": "concurrently -k -n lan,web,app -c cyan,blue,magenta \"npm run lan\" \"cross-env APP_PORT=3061 vite\" \"wait-on tcp:127.0.0.1:3061 && cross-env ELECTRON_RENDERER_URL=http://localhost:3061 electron .\""
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "tsx": "^4.23.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "wait-on": "^9.0.10"
  }
}
